{
  "description": "receipts: log every Bash run to a per-session ledger, then check 'done' claims in the final reply against it.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/record_run.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check_claims.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
